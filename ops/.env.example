# ===== 存储模式 =====
# runtime = 本地 JSON（开发/演示）；prisma = MySQL 持久化（生产必须用此模式）
ERP_STORAGE_MODE=prisma

# ===== 数据库 =====
# 容器内经 host.docker.internal 访问宿主机（宝塔）上的 MySQL。
# 注意：容器里 127.0.0.1 指容器自身，连不到宿主 MySQL，务必用 host.docker.internal。
DATABASE_URL="mysql://erp_user:your_password@host.docker.internal:3306/tradechain_erp"

# ===== API 服务 =====
PORT=3001

# ===== 正式会话签名密钥（必填）=====
# api 与 web 用同一个密钥做 HMAC 签名/验签。两侧不一致 → 所有正式会话请求 403「正式会话签名无效」。
# compose 里 api 经 env_file 读本文件，web 经 environment 显式透传同名变量，所以这里填一次即可。
# NODE_ENV=production 下未配置会直接抛错拒绝服务（不再回落到源码内置密钥）。
# 生成：openssl rand -base64 48
ERP_FORMAL_SESSION_SECRET=

# ===== 浏览器跨域白名单（可选，逗号分隔）=====
# api 默认只放行本机 3000/3002/3003。生产由 web 服务端内网代理转发，浏览器不直连 api，通常无需配置。
# 仅当浏览器需要直接跨域访问 api（如经反向代理域名对外）时，才把对外 origin 填进来。
# ERP_CORS_ORIGINS=https://erp.example.com

# ===== 数据 / 上传目录（容器内路径，对应 erp-data 卷，勿改）=====
ERP_DATA_DIR=/data

# ===== 上传文件对外访问基址（生成附件公开 URL 用）=====
# 填浏览器实际访问 web 的 origin（含协议与端口），如 http://<服务器IP>:3000。
# web 端已内置 /uploads 代理（转发到 api 静态目录），不配 nginx 附件也可访问；
# 日后若改用反向代理域名对外，则把此值改为该域名（须与浏览器访问入口一致）。
ERP_PUBLIC_BASE_URL=http://your-server-ip:3000

# ===== 前端调用后端地址 =====
# 生产由 docker-compose 注入（web 走内网 http://api:3001/api），此处仅本地开发用。
# ERP_API_BASE_URL=http://127.0.0.1:3001/api

# ===== 镜像源（可选）=====
# 默认直连 ghcr.io。docker-compose.yml 与 deploy-remote.sh 都会读这个值做插值，
# 改完必须重新 pull —— 旧源拉下来的镜像不会被新源复用（镜像名含 registry 前缀）。
#
# ⚠️ 但目前换成公共国内镜像站也用不了：本仓库的 GHCR 包是 private，而公共镜像站
# 都是匿名 / 白名单代理，拿不到私有包。实测（2026-09，用公开镜像 astral-sh/uv 做对照组）：
#   ghcr.nju.edu.cn     → 404 MANIFEST_UNKNOWN（对照组 200，且不转发鉴权）
#   ghcr.m.daocloud.io  → 403「这镜像不在白名单」（对照组 200）
# 想用国内源，得先解决私有包的可达性，四选一：
#   0) 给 dockerd 配 HTTPS_PROXY（systemd drop-in）—— 零仓库改动，通常最省事，本项保持注释即可
#   1) 把 GHCR 包设为 public（仓库仍可 private）—— 代价：编译产物任何人可拉取
#   2) 自建带鉴权的反代（如 Cloudflare Worker 注入 PAT），IMAGE_REGISTRY 填自己的域名，
#      并对该域名跑一次 IMAGE_REGISTRY=<域名> make login
#   3) CI 额外推一份到国内 registry（服务器在腾讯云，TCR 走内网最快），凭据放 Actions secrets
# 未解决前保持注释状态，走 ghcr.io 直连。
# IMAGE_REGISTRY=ghcr.io
