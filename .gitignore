# 依赖
node_modules
.pnpm-store

# 构建产物
dist
.next
coverage
*.tsbuildinfo

# 运行时数据（runtime 存储模式的本地 JSON 数据与上传文件）
work/
erp-data/

# 环境变量（可能包含数据库连接串等敏感信息）
.env
.env.*
!.env.example

# 日志
*.log
npm-debug.log*
pnpm-debug.log*

# 操作系统 / 编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# 本机 agent 权限设置（不共享；.qoder/ 下其余内容可按需纳入版本控制）
.qoder/settings.local.json

# 其他
.worktrees
